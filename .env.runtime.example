# Copy to .env on the Raspberry Pi (always-on app, no MinerU).
# Replace CHANGE_ME and PI_LAN_IP as needed.

SECRET_KEY=change_this_in_production_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Shared Postgres running on this Pi (Docker or local install)
POSTGRES_USER=gspr
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=gspr_db
POSTGRES_BIND=0.0.0.0
POSTGRES_HOST_PORT=5432

# App on the Pi talks to local Postgres
DATABASE_URL=postgresql://gspr:CHANGE_ME_strong_password@127.0.0.1:5432/gspr_db
DATA_DIR=./backend/data
UPLOAD_DIR=./uploads

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://PI_LAN_IP

PORT=8000
ROLE=runtime
MINERU_ENABLED=false
