# Security
SECRET_KEY=change_this_in_production_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# Dev default: SQLite. Shared Pi+workstation: use PostgreSQL (see .env.runtime.example / .env.scanner.example).
DATABASE_URL=sqlite:///./data.db
DATA_DIR=./backend/data
UPLOAD_DIR=./uploads
POSTGRES_USER=gspr
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=gspr_db
# Used with: docker compose -f docker-compose.yml -f docker-compose.shared-db.yml up -d db
POSTGRES_BIND=0.0.0.0
POSTGRES_HOST_PORT=5432

# CORS (Comma separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# Deployment
PORT=8000

# Host role (same codebase, two profiles)
#   workstation (scanner): ROLE=scanner  MINERU_ENABLED=true
#   Raspberry Pi (runtime): ROLE=runtime MINERU_ENABLED=false
# When both share DATABASE_URL (Postgres on the Pi), scans on the workstation
# update mappings the Pi serves automatically.
ROLE=scanner
MINERU_ENABLED=true
